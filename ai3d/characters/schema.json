{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI3D Character Card v1",
  "description": "Persistent source definition for characters and independently designed parts; never stores generated results.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "revision",
    "identity",
    "appearance",
    "prompts",
    "references",
    "parts",
    "assembly"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "role",
        "personality_traits",
        "continuity_rules"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "age_group": {
          "type": "string"
        },
        "personality_traits": {
          "$ref": "#/$defs/strings"
        },
        "backstory": {
          "type": "string"
        },
        "continuity_rules": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "appearance": {
      "type": "object",
      "required": [
        "style",
        "silhouette",
        "recognition_traits"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "silhouette": {
          "type": "string"
        },
        "face": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "clothing": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "palette": {
          "$ref": "#/$defs/strings"
        },
        "recognition_traits": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "prompts": {
      "type": "object",
      "required": [
        "master",
        "negative",
        "reference_views"
      ],
      "properties": {
        "master": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "reference_views": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "purpose"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "view": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "units",
        "up_axis",
        "forward_axis",
        "rest_pose"
      ],
      "properties": {
        "units": {
          "type": "string"
        },
        "up_axis": {
          "type": "string"
        },
        "forward_axis": {
          "type": "string"
        },
        "rest_pose": {
          "type": "string"
        },
        "rigging_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "creator": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "$ref": "#/$defs/strings"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "parent",
        "attachment",
        "reference_ids",
        "prompts",
        "generation",
        "quality_gates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "mesh",
            "region",
            "attachment"
          ]
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "prompts": {
          "type": "object",
          "required": [
            "geometry",
            "texture"
          ],
          "properties": {
            "geometry": {
              "type": "string"
            },
            "texture": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "negative": {
              "type": "string"
            }
          }
        },
        "generation": {
          "type": "object",
          "properties": {
            "geometry_backend": {
              "$ref": "#/$defs/backend"
            },
            "texture_backend": {
              "$ref": "#/$defs/backend"
            },
            "shape_steps": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "target_triangles": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "view_resolution": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "reference_width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "reference_height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "quality_gates": {
          "$ref": "#/$defs/strings"
        },
        "notes": {
          "type": "string"
        },
        "reference_view": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
